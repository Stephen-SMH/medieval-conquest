[node name="Rows" type="VBoxContainer" parent="UI/TurnBar"]
layout_mode = 2

[node name="Turn" type="HBoxContainer" parent="UI/TurnBar/Rows"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Date" type="Label" parent="UI/TurnBar/Rows/Turn"]
