[node name="Message" type="Label" parent="UI/TurnBar/Rows"]
custom_minimum_size = Vector2(460, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="Dim" type="ColorRect" parent="UI"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
